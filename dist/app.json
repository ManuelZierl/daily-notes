{
  "format_version": 1,
  "id": "kestral.daily-notes",
  "version": "0.2.1",
  "display_name": "Daily Notes",
  "description": "A backend-free local daily workspace with shared hierarchical tasks, plain-text notes, and explicit LLM drafts.",
  "publisher": {
    "name": "Kestral reference apps"
  },
  "license": "MIT",
  "icon": "ui/icon.svg",
